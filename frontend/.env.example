# Clerk, instância de desenvolvimento (pk_test_). Com a chave, /app entra pelo Clerk.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Sem a chave do Clerk: NEXT_PUBLIC_AUTH_LOCAL=1 liga a entrada local de
# desenvolvimento (equipe ou cliente por e-mail), casada com AUTH_LOCAL=1 na API.
NEXT_PUBLIC_AUTH_LOCAL=

# Para onde o Next reescreve /api/*. Local: a API na 4000.
API_URL=http://localhost:4000
