# Local: Compose na porta 5434. Fora da máquina, Neon.
# develop e preview da Vercel usam um projeto Neon Free, sem dados de produção.
# main usa Neon Launch. O segredo fica na Fly (basecut-api / basecut-api-staging), não aqui.
DATABASE_URL=postgres://basecut:basecut@localhost:5434/basecut
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3010

# Clerk, instância de desenvolvimento (sk_test_). Organization Base Cut:
# a equipe é member (org:admin, org:barbeiro, org:recepcao); o cliente não é.
CLERK_SECRET_KEY=
CLERK_ORG_ID=

# Sem CLERK_SECRET_KEY na máquina: AUTH_LOCAL=1 aceita "Bearer local:equipe:admin" e
# "Bearer local:cliente:<e-mail>". Ignorado em produção.
AUTH_LOCAL=

# Z-API. Se o número for banido, o canal desliga. A entrada da ficha continua no Clerk.
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
BRUNO_WHATSAPP=
SITE_URL=http://localhost:3000

# Opcional. Sem isso, a resposta do lembrete usa a regra local.
EVE_URL=
EVE_TOKEN=

# Opcional. Sem token, o sinal fica pendente na casa.
MERCADOPAGO_TOKEN=
